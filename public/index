<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f1f5f9;--card:#fff;--text:#1e1b4b;--muted:#64748b;--line:#e2e8f0;--title:#1e1b4b;--side:#1e1b4b;--gold:#d4af37;--c1:#243b8a;--c2:#6d2ddf}
