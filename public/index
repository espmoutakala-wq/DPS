   <div class="card" style="--k:var(--c2)"><div class="ic"><svg viewBox="0 0 96 96" width="76" height="76" aria-hidden="true"><defs><linearGradient id="gg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fde68a"/><stop offset="1" stop-color="#d4af37"/></linearGradient><linearGradient id="gb" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4ade80"/><stop offset="1" stop-color="#15803d"/></linearGradient></defs><rect x="6" y="18" width="62" height="36" rx="6" fill="url(#gb)" transform="rotate(-8 37 36)"/><circle cx="36" cy="35" r="9" fill="none" stroke="#dcfce7" stroke-width="3" transform="rotate(-8 37 36)"/><rect x="14" y="26" width="62" height="36" rx="6" fill="url(#gb)" stroke="#14532d" stroke-width="1.5"/><circle cx="45" cy="44" r="9" fill="none" stroke="#dcfce7" stroke-width="3"/><path d="M22 36h6M62 52h6" stroke="#dcfce7" stroke-width="3" stroke-linecap="round"/><g stroke="#8a6d0b" stroke-width="2"><ellipse cx="68" cy="78" rx="20" ry="7" fill="url(#gg)"/><path d="M48 70v8c0 4 9 7 20 7s20-3 20-7v-8" fill="#e8c14a"/><ellipse cx="68" cy="70" rx="20" ry="7" fill="url(#gg)"/><path d="M48 62v8c0 4 9 7 20 7s20-3 20-7v-8" fill="#e8c14a"/><ellipse cx="68" cy="62" rx="20" ry="7" fill="url(#gg)"/></g><text x="68" y="66" text-anchor="middle" font-family="Georgia,serif" font-weight="700" font-size="11" fill="#7c5e0a">F</text></svg></div><h2>MIR-CAISSE</h2><p>Offrandes, dîmes, dépenses et répartition par rubrique, avec rapports et export Excel.</p><button type="button" class="pill" onclick="MIRopen('caisse')">Ouvrir</button></div>
  </div>
