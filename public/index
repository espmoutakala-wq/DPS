>\n<section id=\"t-saisie\">\n <div class=\"card\">\n  <h2>Nouvel effectif<\/h2>\n  <div class=\"grid\">\n   <div><label>Type de culte<\/label><select id=\"type\" onchange=\"syncEco()\"><option>Culte matinal<\/option><option>Culte du soir<\/option><option>Culte dominical<\/option><option>Séminaire<\/option><\/select><\/div>\n   <div><label>Date<\/label><input type=\"date\" id=\"date\" onchange=\"syncDay()\"><\/div>\n   <div><label>Jour<\/label><input id=\"jour\" readonly><\/div>\n  <\/div>\n  <div id=\"live\" class=\"live\">\n   <h3>🖐 Comptage en direct<\/h3>\n   <p class=\"sub\">Touchez une catégorie à chaque personne qui arrive : l'effectif augmente de 1. Le bouton − corrige une erreur.<\/p>\n   <div class=\"tiles\" role=\"radiogroup\" aria-label=\"Catégories\">\n    <div style=\"position:relative\"><button type=\"button\" class=\"tile\" onclick=\"tap('h')\" role=\"radio\" aria-checked=\"false\"><span class=\"lbl\"><span class=\"dot\"><\/span>Homme<\/span><span class=\"cnt\" id=\"c-h\">0<\/span><\/button><button type=\"button\" class=\"minus\" onclick=\"untap('h')\" title=\"Retirer 1\">−<\/button><\/div>\n    <div style=\"position:relative\"><button type=\"button\" class=\"tile\" onclick=\"tap('f')\" role=\"radio\" aria-checked=\"false\"><span class=\"lbl\"><span class=\"dot\"><\/span>Femme<\/span><span class=\"cnt\" id=\"c-f\">0<\/span><\/button><button type=\"button\" class=\"minus\" onclick=\"untap('f')\" title=\"Retirer 1\">−<\/button><\/div>\n    <div style=\"position:relative\"><button type=\"button\" class=\"tile\" onclick=\"tap('enf')\" role=\"radio\" aria-checked=\"false\"><span class=\"lbl\"><span class=\"dot\"><\/span>Enfant<\/span><span class=\"cnt\" id=\"c-enf\">0<\/span><\/button><button type=\"button\" class=\"minus\" onclick=\"untap('enf')\" title=\"Retirer 1\">−<\/button><\/div>\n    <div id=\"tileEco\" style=\"position:relative\"><button type=\"button\" class=\"tile\" onclick=\"tap('eco')\" role=\"radio\" aria-checked=\"false\"><span class=\"lbl\"><span class=\"dot\"><\/span>Ecodim<\/span><span class=\"cnt\" id=\"c-eco\">0<\/span><\/button><button type=\"button\" class=\"minus\" onclick=\"untap('eco')\" title=\"Retirer 1\">−<\/button><\/div>\n   <\/div>\n   <div class=\"liveBar\">\n    <span class=\"big\">Total en cours : <b id=\"liveTot\">0<\/b><\/span>\n    <span style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"btn danger\" onclick=\"resetLive()\">↺ Tout effacer<\/button><button class=\"btn end\" onclick=\"endCulte()\">✔ Fin du culte<\/button><\/span>\n   <\/div>\n  <\/div>\n  <div class=\"grid\" style=\"margin-top:12px\">\n   <div><label>Hommes<\/label><input type=\"number\" min=\"0\" id=\"h\" value=\"0\" oninput=\"calc()\"><\/div>\n   <div><label>Femmes<\/label><input type=\"number\" min=\"0\" id=\"f\" value=\"0\" oninput=\"calc()\"><\/div>\n   <div><label>Enfants<\/label><input type=\"number\" min=\"0\" id=\"enf\" value=\"0\" oninput=\"calc()\"><\/div>\n   <div id=\"ecoBox\"><label>Ecodim<\/label><input type=\"number\" min=\"0\" id=\"eco\" value=\"0\" oninput=\"calc()\"><\/div>\n  <\/div>\n  <div class=\"total\"><span>Total : <b id=\"tot\">0<\/b><\/span><button class=\"btn\" onclick=\"add()\">Enregistrer<\/button><\/div>\n  <button type=\"button\" class=\"btn ghost resume-btn\" id=\"resBtn\" onclick=\"toggleResume()\" aria-expanded=\"false\">📝 Résumé du culte<\/button>\n  <div id=\"resume\" class=\"resume hide\">\n   <h3>📝 Résumé du culte<\/h3>\n   <div class=\"field\"><label for=\"r-mod\">Modérateur<\/label><input id=\"r-mod\" type=\"text\" placeholder=\"Nom du modérateur\" oninput=\"saveRes()\"><\/div>\n   <div class=\"field\"><label for=\"r-ora\">Orateur<\/label><input id=\"r-ora\" type=\"text\" placeholder=\"Nom de l'orateur\" oninput=\"saveRes()\"><\/div>\n   <div class=\"field\"><label for=\"r-the\">Thème<\/label><input id=\"r-the\" type=\"text\" placeholder=\"Thème du message\" oninput=\"saveRes()\"><\/div>\n   <div class=\"field\"><label for=\"r-ref\">Référence biblique<\/label><input id=\"r-ref\" type=\"text\" placeholder=\"Ex. : Jean 3:16-21\" oninput=\"saveRes()\"><\/div>\n   <div class=\"field\"><label for=\"r-syn\">Synthèse du culte<\/label><textarea id=\"r-syn\" placeholder=\"Rédigez ici la synthèse du culte…\" oninput=\"saveRes()\"><\/textarea><\/div>\n   <p style=\"margin:0;font-size:12px;color:var(--muted)\">Le résumé est conservé automatiquement et sera enregistré avec l'effectif du culte.<\/p>\n  <\/div>\n  <p id=\"msg\" style=\"color:var(--danger);margin:8px 0 0;font-size:13px\"><\/p>\n <\/div>\n <div class=\"card\"><h2>Dernières saisies<\/h2><div class=\"scroll\"><table><thead><tr><th>Date<\/th><th>Culte<\/th><th class=\"n\">H<\/th><th class=\"n\">F<\/th><th class=\"n\">Enf<\/th><th class=\"n\">Eco<\/th><th class=\"n\">Total<\/th><th><\/th><\/tr><\/thead><tbody id=\"recent\"><\/tbody><\/table><\/div><\/div>\n<\/section>\n\n<section id=\"t-rapport\" class=\"hide\">\n <div class=\"card\">\n  <h2>Filtres<\/h2>\n  <div class=\"grid\">\n   <div><label>Année<\/label><select id=\"fa\" onchange=\"report()\"><\/select><\/div>\n   <div><label>Période<\/label><select id=\"fp\" onchange=\"report()\"><option value=\"all\">Toute l'année<\/option><option value=\"m\">Un mois<\/option><option value=\"t\">Un trimestre<\/option><\/select><\/div>\n   <div><label id=\"fvl\">Valeur<\/label><select id=\"fv\" onchange=\"report()\"><\/select><\/div>\n   <div><label>Culte<\/label><select id=\"ft\" onchange=\"report()\"><option value=\"\">Tous<\/option><option>Culte matinal<\/option><option>Culte du soir<\/option><option>Culte dominical<\/option><option>Séminaire<\/option><\/select><\/div>\n  <\/div>\n <\/div>\n <div class=\"kpi\" id=\"kpi\"><\/div>\n <div class=\"card\"><h2>Synthèse par type de culte<\/h2><div class=\"scroll\"><table><thead><tr><th>Culte<\/th><th class=\"n\">Séances<\/th><th class=\"n\">H<\/th><th class=\"n\">F<\/th><th class=\"n\">Enf<\/th><th class=\"n\">Eco<\/th><th class=\"n\">Total<\/th><th class=\"n\">Moy.<\/th><\/tr><\/thead><tbody id=\"syn\"><\/tbody><tfoot id=\"synf\"><\/tfoot><\/table><\/div><\/div>\n <div class=\"card\"><h2>Détail<\/h2><div class=\"scroll\"><table><thead><tr><th>Date<\/th><th>Jour<\/th><th>Culte<\/th><th class=\"n\">H<\/th><th class=\"n\">F<\/th><th class=\"n\">Enf<\/th><th class=\"n\">Eco<\/th><th class=\"n\">Total<\/th><\/tr><\/thead><tbody id=\"det\"><\/tbody><\/table><\/div><\/div>\n <div class=\"card\"><h2>📝 Résumés des cultes<\/h2><div id=\"resList\"><\/div><\/div>\n <div class=\"card\" style=\"display:flex;gap:10px;flex-wrap:wrap\"><button class=\"btn\" onclick=\"exportXlsx()\" title=\"Exporte la sélection affichée\">📥 Exporter les données vers Excel<\/button><button class=\"btn danger\" onclick=\"clearAll()\">Supprimer toutes les données<\/button><\/div>\n<\/section>\n<\/main>\n<div id=\"admin\" class=\"modal hide\"><div class=\"box\"><h2>Accès administrateur<\/h2><p style=\"color:var(--muted);font-size:13px;margin:0\">Entrez le code pour continuer.<\/p><input type=\"password\" id=\"code\" placeholder=\"Code admin\" onkeydown=\"if(event.key==='Enter')checkAdmin()\"><p id=\"err\" class=\"hide\" style=\"color:var(--danger);font-size:13px;margin:0 0 10px\">Code incorrect.<\/p><div class=\"row\"><button class=\"btn ghost\" onclick=\"closeAdmin()\">Annuler<\/button><button class=\"btn\" onclick=\"checkAdmin()\">Valider<\/button><\/div><\/div><\/div>\n<div id=\"endModal\" class=\"modal hide\"><div class=\"box l\"><h2 style=\"text-align:center\">Fin du culte<\/h2><p id=\"endInfo\" style=\"color:var(--muted);font-size:13px;margin:0 0 10px;text-align:center\"><\/p><div id=\"endRows\"><\/div><div class=\"row\" style=\"margin-top:14px\"><button class=\"btn ghost\" onclick=\"$('endModal').classList.add('hide')\">Continuer<\/button><button class=\"btn end\" onclick=\"confirmEnd()\">Enregistrer<\/button><\/div><\/div><\/div>\n<footer>Auteur : Finish Espoir MOUTAKALA M. (Cartographe, Ingénieur en Travaux Statistiques)<\/footer>\n<div id=\"dgate\" class=\"modal\"><div class=\"box\"><h2>DPS-Suivi des cultes<\/h2><p style=\"color:var(--muted);font-size:13px;margin:0\">Entrez le code d’accès à l’application.<\/p><input type=\"password\" id=\"dgc\" placeholder=\"Code d’accès\" autocomplete=\"off\" onkeydown=\"if(event.key==='Enter')dpsGo()\"><p id=\"dge\" class=\"hide\" style=\"color:var(--danger);font-size:13px;margin:0 0 10px\">Code incorrect.<\/p><button class=\"btn\" style=\"width:100%\" onclick=\"dpsGo()\">Entrer<\/button><\/div><\/div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js\"><\/script>\n<script>\nconst KEY='mir_effectifs_simple',MOIS=['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'],JOURS=['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];\nconst TYPES=['Culte matinal','Culte du soir','Culte dominical','Séminaire'];\nlet data=[];\ntry{data=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){data=[]}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){}}\nconst $=id=>document.getElementById(id), num=id=>Math.max(0,parseInt($(id).value)||0);\nconst fmtD=d=>d.split('-').reverse().join('/');\nconst tot=r=>r.h+r.f+r.enf+r.eco;\nfunction dpsGo(){if($('dgc').value==='mirdps'){document.body.classList.remove('locked');$('dgate').classList.add('hide')}else{$('dge').classList.remove('hide');$('dgc').value='';$('dgc').focus()}}\nsetTimeout(function(){try{$('dgc').focus()}catch(e){}},50);\nconst ADMIN_CODE='0987654321';let unlocked=false,pending=null;function ask(fn){pending=fn;openAdmin();}\nfunction openAdmin(){$('code').value='';$('err').classList.add('hide');$('admin').classList.remove('hide');$('code').focus();}\nfunction closeAdmin(){pending=null;$('admin').classList.add('hide');}\nfunction checkAdmin(){if($('code').value===ADMIN_CODE){const f=pending;closeAdmin();if(f){f();}else{tab('rapport');}}else{$('err').classList.remove('hide');$('code').value='';}}\nfunction tab(t){['saisie','rapport'].forEach(x=>{$('t-'+x).classList.toggle('hide',x!==t);$('b-'+x).classList.toggle('on',x===t)});if(t==='rapport')report();}\nfunction syncDay(){const v=$('date').value;$('jour').value=v?JOURS[new Date(v+'T12:00:00').getDay()]:'';\n if(v){const d=new Date(v+'T12:00:00').getDay();if(d===0)$('type').value='Culte dominical';else if($('type').value==='Culte dominical')$('type').value='Culte matinal';}\n syncEco();}\nfunction syncEco(){const dim=$('type').value==='Culte dominical';$('ecoBox').classList.toggle('hide',!dim);$('tileEco').classList.toggle('hide',!dim);if(!dim)$('eco').value=0;$('live').classList.toggle('hide',!$('date').value);calc();}\nfunction calc(){const t=num('h')+num('f')+num('enf')+($('type').value==='Culte dominical'?num('eco'):0);$('tot').textContent=t;$('liveTot').textContent=t;['h','f','enf','eco'].forEach(i=>$('c-'+i).textContent=num(i));saveLive();}\nconst LKEY='mir_effectifs_live';\nfunction saveLive(){try{localStorage.setItem(LKEY,JSON.stringify({date:$('date').value,type:$('type').value,h:num('h'),f:num('f'),enf:num('enf'),eco:num('eco')}))}catch(e){}}\nfunction restoreLive(){try{const l=JSON.parse(localStorage.getItem(LKEY)||'null');if(l&&l.date){$('date').value=l.date;$('type').value=l.type;['h','f','enf','eco'].forEach(i=>$(i).value=l[i]||0);}}catch(e){}}\nfunction tap(k){$(k).value=num(k)+1;if(navigator.vibrate)try{navigator.vibrate(15)}catch(e){}calc();}\nfunction untap(k){$(k).value=Math.max(0,num(k)-1);calc();}\nfunction resetLive(){if(!(num('h')+num('f')+num('enf')+num('eco'))||confirm('Remettre le comptage en cours à zéro ?')){['h','f','enf','eco'].forEach(i=>$(i).value=0);$('msg').textContent='';calc();}}\nfunction endCulte(){\n const dim=$('type').value==='Culte dominical',h=num('h'),f=num('f'),e=dim?num('eco'):0,en=num('enf');\n const rows=[['Hommes',h],['Femmes',f],['Enfants',en]];if(dim)rows.push(['Ecodim',e]);\n $('endInfo').textContent=$('type').value+' — '+$('jour').value+' '+fmtD($('date').value||'');\n $('endRows').innerHTML=rows.map(([l,v])=>`<div class=\"sumrow\"><span>${l}<\/span><b>${v}<\/b><\/div>`).join('')+`<div class=\"sumrow t\"><span>TOTAL GÉNÉRAL<\/span><span>${h+f+en+e}<\/span><\/div>`;\n $('endModal').classList.remove('hide');\n}\nconst RKEY='mir_resume_draft',RF=['mod','ora','the','ref','syn'];\nfunction getRes(){const o={};RF.forEach(k=>o[k]=$('r-'+k).value.trim());return o}\nfunction saveRes(){try{localStorage.setItem(RKEY,JSON.stringify(getRes()))}catch(e){}}\nfunction toggleResume(){const h=$('resume').classList.toggle('hide');$('resBtn').setAttribute('aria-expanded',String(!h));if(!h)$('r-mod').focus();}\nfunction clearRes(){RF.forEach(k=>$('r-'+k).value='');try{localStorage.removeItem(RKEY)}catch(e){}}\n(function(){try{const r=JSON.parse(localStorage.getItem(RKEY)||'null');if(r){RF.forEach(k=>$('r-'+k).value=r[k]||'');if(RF.some(k=>r[k])){$('resume').classList.remove('hide');$('resBtn').setAttribute('aria-expanded','true')}}}catch(e){}})();\nfunction confirmEnd(){$('endModal').classList.add('hide');add();}\nfunction add(){\n const date=$('date').value;if(!date){$('msg').textContent='Choisissez une date.';return}$('msg').style.color='var(--danger)';\n const type=$('type').value,jour=$('jour').value;\n const ok={'Culte matinal':[1,2,3,4,5],'Culte du soir':[2,4],'Culte dominical':[0],'Séminaire':[0,1,2,3,4,5,6]}[type];\n if(!ok.includes(new Date(date+'T12:00:00').getDay())){$('msg').textContent='« '+type+' » ne se tient pas le '+jour.toLowerCase()+'.';return}\n if(data.some(r=>r.date===date&&r.type===type)&&!confirm('Une saisie existe déjà pour ce culte à cette date. Ajouter quand même ?'))return;\n $('msg').textContent='';\n data.push({id:Date.now(),type,date,h:num('h'),f:num('f'),enf:num('enf'),eco:type==='Culte dominical'?num('eco'):0,resume:getRes()});\n save();clearRes();['h','f','enf','eco'].forEach(i=>$(i).value=0);calc();render();$('msg').style.color='#16a34a';$('msg').textContent='✔ Effectif enregistré. Le comptage est remis à zéro.';setTimeout(()=>{$('msg').textContent='';$('msg').style.color='var(--danger)'},4000);\n}\nfunction del(id){ask(()=>{if(confirm('Supprimer cette saisie ?')){data=data.filter(r=>r.id!==id);save();render();report();}});}\nfunction clearAll(){ask(()=>{if(confirm('Supprimer TOUTES les données ? Cette action est irréversible.')){data=[];save();render();report();}});}\nfunction render(){\n const rows=[...data].sort((a,b)=>b.date.localeCompare(a.date)||b.id-a.id).slice(0,8);\n $('recent').innerHTML=rows.length?rows.map(r=>`<tr><td>${fmtD(r.date)}<\/td><td>${r.type}<\/td><td class=\"n\">${r.h}<\/td><td class=\"n\">${r.f}<\/td><td class=\"n\">${r.enf}<\/td><td class=\"n\">${r.eco}<\/td><td class=\"n\"><b>${tot(r)}<\/b><\/td><td><button class=\"x\" onclick=\"del(${r.id})\" title=\"Supprimer\">✕<\/button><\/td><\/tr>`).join(''):'<tr><td colspan=\"8\" class=\"empty\">Aucune saisie pour le moment.<\/td><\/tr>';\n}\nfunction initFilters(){\n const y=new Date().getFullYear();let o='';for(let a=2026;a<=2036;a++)o+=`<option ${a===Math.max(2026,Math.min(2036,y))?'selected':''}>${a}<\/option>`;$('fa').innerHTML=o;\n fillV();\n}\nfunction fillV(){\n const p=$('fp').value,m=new Date().getMonth();\n $('fv').parentElement.classList.toggle('hide',p==='all');\n if(p==='m'){$('fvl').textContent='Mois';$('fv').innerHTML=MOIS.map((x,i)=>`<option value=\"${i}\" ${i===m?'selected':''}>${x}<\/option>`).join('')}\n if(p==='t'){$('fvl').textContent='Trimestre';$('fv').innerHTML=[1,2,3,4].map(i=>`<option value=\"${i-1}\" ${i-1===Math.floor(m/3)?'selected':''}>T${i}<\/option>`).join('')}\n}\nlet lastP='all';\nfunction report(){\n if($('fp').value!==lastP){lastP=$('fp').value;fillV();}\n const a=+$('fa').value,p=$('fp').value,v=+$('fv').value,t=$('ft').value;\n const rows=data.filter(r=>{const d=new Date(r.date+'T12:00:00');if(d.getFullYear()!==a)return false;\n  if(p==='m'&&d.getMonth()!==v)return false;if(p==='t'&&Math.floor(d.getMonth()/3)!==v)return false;return !t||r.type===t}).sort((x,y)=>x.date.localeCompare(y.date));\n const S=