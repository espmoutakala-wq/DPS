:root[data-theme="dark"]{color-scheme:dark;--bg:#0f172a;--card:#1e293b;--text:#e2e8f0;--muted:#94a3b8;--line:#334155;--title:#e0e7ff}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box}
body{margin:0;height:100%;display:flex;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:16px}
aside{width:270px;flex:none;background:var(--side);color:#fff;border-right:6px solid var(--gold);overflow-y:auto;display:flex;flex-direction:column}
.brand{padding:22px 16px 16px;border-bottom:1px solid rgba(255,255,255,.14)}
.brand b{display:block;font-size:19px;line-height:1.3}
.brand small{display:block;margin-top:8px;font-size:12px;letter-spacing:.14em;color:#a5b4fc}
.sec{margin:20px 16px 6px;font-size:12px;letter-spacing:.16em;color:#a5b4fc}
.nv{display:flex;align-items:center;gap:14px;width:calc(100% - 16px);margin:4px 8px;padding:13px 14px;border:0;border-radius:14px;background:none;color:#fff;font:inherit;font-weight:700;text-align:left;cursor:pointer;border-left:4px solid transparent}
.nv:hover{background:rgba(255,255,255,.1)}
.nv.on{background:rgba(255,255,255,.24);border-left-color:var(--gold)}
.nv .e{font-size:22px;width:28px;text-align:center}
main{flex:1;min-width:0;display:flex;flex-direction:column;overflow-y:auto}
#home{padding:40px 24px 30px;text-align:center}
#home h1{margin:0;font-size:clamp(30px,5vw,54px);color:var(--title);letter-spacing:.02em}
#home .sub{margin:12px 0 30px;font-size:18px;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;max-width:960px;margin:0 auto}
.card{background:var(--card);border-radius:26px;overflow:hidden;box-shadow:0 10px 30px rgba(30,27,75,.14);display:flex;flex-direction:column;align-items:center;padding:0 22px 28px;border-top:8px solid var(--k)}
.card .ic{margin:24px 0 10px;height:80px;display:flex;align-items:center}
.card h2{margin:6px 0 8px;font-size:clamp(22px,3vw,30px);color:var(--title)}
.card p{margin:0 0 22px;color:var(--muted);line-height:1.5;max-width:340px}
.pill{margin-top:auto;padding:14px 38px;border:0;border-radius:999px;background:var(--k);color:#fff;font:inherit;font-size:18px;font-weight:800;cursor:pointer}
.both{display:inline-block;margin:28px auto 0;padding:16px 32px;border:3px dashed #64748b;border-radius:999px;background:none;color:var(--title);font:inherit;font-size:18px;font-weight:800;cursor:pointer}
.ft{margin-top:26px;font-size:13px;color:var(--muted)}
#one,#two{flex:1;min-height:0;display:none}
#one iframe{width:100%;height:100%;border:0;display:block}
#two{gap:2px;background:var(--line)}
.pane{flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;background:var(--bg)}
.pane b{padding:6px 12px;background:var(--side);color:#fff;font-size:13px}
.pane iframe{flex:1;width:100%;border:0;min-height:0}
@media (max-width:760px){
 body{flex-direction:column}
 aside{width:100%;border-right:0;border-bottom:5px solid var(--gold);flex-direction:row;flex-wrap:wrap;align-items:center;overflow:visible;padding:6px 8px}
 .brand{width:100%;padding:8px 8px 6px;border:0}.brand b{font-size:15px}.brand small,.sec{display:none}
 .nv{width:auto;flex:1 1 auto;margin:3px;padding:9px 10px;font-size:13px;gap:8px;justify-content:center}.nv .e{font-size:18px;width:auto}
 #two{flex-direction:column}
}
</style>
</head>
