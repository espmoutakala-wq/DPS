var MIRAPPS={caisse:{t:'MIR-CAISSE',h:"<!DOCTYPE html>\n<html lang=\"fr\">\n<head><script>try{Object.defineProperty(window,'claude',{get:function(){return parent.claude},configurable:true})}catch(e){}<\/script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>MIR-CAISSE<\/title>\n<style>\n:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);\n--b1:#dbeafe;--b2:#ede9fe;--b3:#dcfce7;--card:#fff;--text:#1e1b4b;--muted:#6b7280;--line:#e5e7eb;--blue:#1d4ed8;--violet:#6d28d9;--green:#16a34a;--red:#dc2626;--gold:#d4af37;--soft:#f5f3ff;--inp:#fff}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){color-scheme:dark;--b1:#0b1230;--b2:#1e1245;--b3:#0a2a22;--card:#161a3a;--text:#e8e9ff;--muted:#a1a6c8;--line:#2c3166;--soft:#1f2350;--inp:#0f1330;--green:#4ade80;--red:#f87171}}\n:root[data-theme=\"dark\"]{color-scheme:dark;--b1:#0b1230;--b2:#1e1245;--b3:#0a2a22;--card:#161a3a;--text:#e8e9ff;--muted:#a1a6c8;--line:#2c3166;--soft:#1f2350;--inp:#0f1330;--green:#4ade80;--red:#f87171}\nhtml{scroll-padding-top:env(safe-area-inset-top,0px)}*{box-sizing:border-box}\nbody{margin:0;color:var(--text);background:var(--b2) linear-gradient(160deg,var(--b1),var(--b2) 55%,var(--b3)) fixed;font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-size:15px;min-height:100vh}\n.hide{display:none!important}\nheader{background:linear-gradient(135deg,#1e3a8a,#6d28d9 60%,#0f766e);color:#fff;text-align:center;padding:18px 12px 14px;border-bottom:4px solid var(--gold)}\nh1{margin:0;font-size:32px;letter-spacing:.08em;background:linear-gradient(90deg,#fde68a,#d4af37,#fff3b0);-webkit-background-clip:text;background-clip:text;color:transparent}\n.sub{font-family:\"Brush Script MT\",\"Brush Script Std\",\"Segoe Script\",cursive;font-size:24px;color:#fde68a;margin-top:2px}\n.auth{font-size:12px;opacity:.85;margin-top:4px}\nnav{display:flex;gap:8px;max-width:960px;margin:14px auto 0;padding:0 12px}\nnav button{flex:1;padding:11px 6px;border:2px solid var(--gold);border-radius:10px;background:var(--card);color:var(--violet);font-weight:700;font-size:14px;letter-spacing:.04em;cursor:pointer}\nnav button.on{background:linear-gradient(135deg,#d4af37,#f5d76e);color:#1e1b4b}\nmain{max-width:960px;margin:0 auto;padding:12px}\n.card{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:14px;padding:16px;margin-bottom:14px;box-shadow:0 4px 14px rgba(76,29,149,.1)}\nh2{margin:0 0 12px;font-size:16px;color:var(--violet)}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:12px}\nlabel{display:block;font-size:12px;color:var(--muted);margin-bottom:4px;font-weight:600}\ninput,select{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--inp);color:var(--text);font:inherit}\ninput[readonly]{background:var(--soft);font-weight:700}\n.g1 input{border-color:#93c5fd}.auto input{border-color:#c4b5fd}\n.btn{padding:11px 18px;border:0;border-radius:10px;background:linear-gradient(135deg,#1d4ed8,#6d28d9);color:#fff;font:inherit;font-weight:700;cursor:pointer}\n.btn.gold{background:linear-gradient(135deg,#d4af37,#f5d76e);color:#1e1b4b}.btn.red{background:var(--red);color:#fff}.btn.ghost{background:var(--line);color:var(--text)}\n.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.msg{color:var(--red);font-size:13px;margin:8px 0 0}.ok{color:var(--green)}\n.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}\nth,td{padding:9px 8px;border-bottom:1px solid var(--line);white-space:nowrap;text-align:left}\nth{background:linear-gradient(135deg,#1e3a8a,#6d28d9);color:#fff;font-size:12px;text-transform:uppercase}\ntd.n,th.n{text-align:right}tfoot td{font-weight:800;background:var(--soft);border-top:2px solid var(--gold)}\nem{font-style:normal;font-size:11px;font-weight:700;margin-left:6px}.up{color:var(--green)}.dn{color:var(--red)}\n.empty{text-align:center;color:var(--muted);padding:18px}\n.dso-ok{background:#dcfce7!important;border-color:#16a34a!important;color:#166534!important}\n.dso-no{background:#fee2e2!important;border-color:#dc2626!important;color:#991b1b!important}\n@keyframes blk{0%,100%{opacity:1}50%{opacity:.25}}\n.dso-ok.blink,.dso-no.blink{animation:blk .45s ease-in-out 7}\n.card.out{border-top-color:var(--red)}.card.out h2{color:var(--red)}\ntextarea{width:100%;min-height:80px;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--inp);color:var(--text);font:inherit;resize:vertical}\ntd.w{white-space:normal;min-width:180px}.neg{color:var(--red);font-weight:800}\n.modal{position:fixed;inset:0;background:rgba(15,23,42,.75);display:flex;align-items:center;justify-content:center;padding:16px;z-index:10}\n.modal .box{background:var(--card);border:2px solid var(--gold);border-radius:14px;padding:22px;max-width:340px;width:100%;text-align:center}\n.modal input{text-align:center;font-size:18px;letter-spacing:.15em;margin:10px 0}.modal .bar .btn{flex:1}\n<\/style>\n<\/head>\n<body>\n<header><h1>MIR-CAISSE<\/h1><div class=\"sub\">(Mon application de gestion)<\/div><div class=\"auth\">Auteur : Frère Finish Espoir<\/div><\/header>\n<nav id=\"nv\" class=\"hide\"><button id=\"bs\" class=\"on\" onclick=\"tab('s')\">SAISIE<\/button><button id=\"br\" onclick=\"tab('r')\">RAPPORT<\/button><button id=\"bp\" onclick=\"tab('p')\"><span id=\"lk\">🔒 <\/span>PARAMETRE<\/button><\/nav>\n<main id=\"mn\" class=\"hide\">\n<section id=\"ts\">\n <div class=\"card\"><h2>Nouvelle entrée<\/h2>\n  <div class=\"grid\"><div><label>Type de culte<\/label><select id=\"ty\"><\/select><\/div><div><label>Date (cliquez pour ouvrir le calendrier)<\/label><input type=\"date\" id=\"dt\" min=\"2024-01-01\" max=\"2040-12-31\" onclick=\"try{this.showPicker()}catch(e){}\"><\/div><\/div>\n  <div class=\"grid g1\"><div><label>Offrandes (FCFA)<\/label><input type=\"number\" min=\"0\" id=\"off\" value=\"0\" oninput=\"recalc()\"><\/div><div><label>Dîmes (FCFA)<\/label><input type=\"number\" min=\"0\" id=\"dim\" value=\"0\" oninput=\"recalc()\"><\/div><\/div>\n  <div class=\"grid auto\"><div><label>Total Entrées<\/label><input id=\"tot\" readonly><\/div><div><label>Compte<\/label><input id=\"cpt\" readonly><\/div><div><label>Gestion du Berger<\/label><input id=\"ber\" readonly><\/div><div><label>Fonctionnement<\/label><input id=\"fon\" readonly><\/div><\/div>\n  <div class=\"bar\"><button class=\"btn gold\" onclick=\"add()\">Enregistrer<\/button><\/div><p class=\"msg\" id=\"msg\"><\/p>\n <\/div>\n <div class=\"card out\"><h2>Nouvelle dépense<\/h2>\n  <div class=\"grid\"><div><label>Dépense faite sur (rubrique)<\/label><select id=\"dr\" onchange=\"dSolde();chkD()\"><option value=\"\">— Choisir la rubrique —<\/option><option value=\"cpt\">Compte<\/option><option value=\"ber\">Gestion du Berger<\/option><option value=\"fon\">Fonctionnement<\/option><\/select><\/div><div class=\"auto\"><label>Solde disponible<\/label><input id=\"dso\" readonly placeholder=\"—\"><\/div><div class=\"auto\"><label>Date (automatique)<\/label><input id=\"dd\" readonly><\/div><\/div>\n  <div class=\"grid\"><div class=\"g1\"><label>Montant de la dépense (FCFA)<\/label><input type=\"number\" min=\"0\" id=\"dm2\" value=\"0\" oninput=\"chkD()\"><\/div><\/div>\n  <div style=\"margin-bottom:12px\"><label>Motif de la dépense (cause / justification)<\/label><textarea id=\"dmo\" placeholder=\"Pourquoi cette dépense a-t-elle été faite ?\"><\/textarea><\/div>\n  <div class=\"bar\"><button class=\"btn red\" onclick=\"addD()\">Enregistrer la dépense<\/button><\/div><p class=\"msg\" id=\"dmsg\"><\/p>\n <\/div>\n <div class=\"card out\"><h2>Dernières dépenses<\/h2><div class=\"scroll\"><table><thead><tr><th>Date<\/th><th>Rubrique<\/th><th>Motif<\/th><th class=\"n\">Montant<\/th><\/tr><\/thead><tbody id=\"recd\"><\/tbody><\/table><\/div><\/div>\n <div class=\"card\"><h2>Dernières entrées<\/h2><div class=\"scroll\"><table><thead><tr><th>Date<\/th><th>Culte<\/th><th class=\"n\">Offrandes<\/th><th class=\"n\">Dîmes<\/th><th class=\"n\">Total<\/th><\/tr><\/thead><tbody id=\"rec\"><\/tbody><\/table><\/div><\/div>\n<\/section>\n\n<section id=\"tr\" class=\"hide\">\n <div class=\"card\"><h2>Filtres du rapport<\/h2>\n  <div class=\"grid\"><div><label>Période<\/label><select id=\"rp\" onchange=\"report()\"><option value=\"m\">Mensuel<\/option><option value=\"t\">Trimestriel<\/option><option value=\"a\">Annuel<\/option><\/select><\/div><div id=\"ryw\"><label>Année<\/label><select id=\"ry\" onchange=\"report()\"><\/select><\/div><div><label>Type de culte<\/label><select id=\"rt\" onchange=\"report()\"><\/select><\/div><\/div>\n  <div class=\"bar\"><button class=\"btn gold\" onclick=\"exportX()\">📥 Exporter les données vers Excel<\/button><\/div>\n <\/div>\n <div class=\"card\"><h2 id=\"rh\">Rapport<\/h2><div class=\"scroll\"><table><thead><tr><th>Période<\/th><th class=\"n\">Offrandes<\/th><th class=\"n\">Dîmes<\/th><th class=\"n\">Total Entrées<\/th><th class=\"n\">Compte<\/th><th class=\"n\">Gestion du Berger<\/th><th class=\"n\">Fonctionnement<\/th><\/tr><\/thead><tbody id=\"rb\"><\/tbody><tfoot id=\"rf\"><\/tfoot><\/table><\/div>\n <p style=\"font-size:12px;color:var(--muted);margin:10px 0 0\"><em class=\"up\">▲<\/em> hausse &nbsp; <em class=\"dn\">▼<\/em> baisse par rapport à la période précédente (périodes avec saisies uniquement).<\/p><\/div>\n <div class=\"card\"><h2 id=\"sh\">Situation des rubriques<\/h2><div class=\"scroll\"><table><thead><tr><th>Rubrique<\/th><th class=\"n\">Report antérieur<\/th><th class=\"n\">Entrées<\/th><th class=\"n\">Dépenses<\/th><th class=\"n\">Reste<\/th><\/tr><\/thead><tbody id=\"sb\"><\/tbody><tfoot id=\"sf\"><\/tfoot><\/table><\/div>\n <p style=\"font-size:12px;color:var(--muted);margin:10px 0 0\">Reste = Report antérieur + Entrées − Dépenses. Cette situation concerne l'année choisie (ou toutes les années en mode annuel) et ne tient pas compte du filtre « Type de culte ».<\/p><\/div>\n <div class=\"card out\"><h2 id=\"oh\">Sorties de caisse (dépenses)<\/h2><div class=\"scroll\"><table><thead><tr><th>Date<\/th><th>Rubrique<\/th><th>Motif<\/th><th class=\"n\">Montant<\/th><\/tr><\/thead><tbody id=\"ob\"><\/tbody><tfoot id=\"of\"><\/tfoot><\/table><\/div><\/div>\n<\/section>\n\n<section id=\"tp\" class=\"hide\">\n <div class=\"card\"><h2>Supprimer les données<\/h2>\n  <div class=\"grid\"><div><label>Portée<\/label><select id=\"dy\"><\/select><\/div><\/div>\n  <button class=\"btn red\" onclick=\"delData()\">Supprimer les données<\/button><p class=\"msg\" id=\"dm\"><\/p><\/div>\n <div class=\"card\"><h2>Supprimer une ligne de données<\/h2><p style=\"font-size:12px;color:var(--muted);margin:0 0 10px\">En cas d'erreur, supprimez la ligne concernée, puis ressaisissez-la dans SAISIE.<\/p><div class=\"scroll\" style=\"max-height:340px;overflow-y:auto\"><table><thead><tr><th>Date<\/th><th>Culte<\/th><th class=\"n\">Offrandes<\/th><th class=\"n\">Dîmes<\/th><th class=\"n\">Total<\/th><th><\/th><\/tr><\/thead><tbody id=\"dl\"><\/tbody><\/table><\/div><\/div>\n <div class=\"card\"><h2>Supprimer une dépense<\/h2><p style=\"font-size:12px;color:var(--muted);margin:0 0 10px\">En cas d'erreur, supprimez la dépense concernée, puis ressaisissez-la dans SAISIE.<\/p><div class=\"scroll\" style=\"max-height:340px;overflow-y:auto\"><table><thead><tr><th>Date<\/th><th>Rubrique<\/th><th>Motif<\/th><th class=\"n\">Montant<\/th><th><\/th><\/tr><\/thead><tbody id=\"dld\"><\/tbody><\/table><\/div><\/div>\n <div class=\"card\"><h2>Modifier les codes d'accès<\/h2>\n  <div class=\"grid\"><div><label>Code à modifier<\/label><select id=\"cw\"><option value=\"app\">Code d'accès à l'application<\/option><option value=\"adm\">Code admin (paramètres)<\/option><\/select><\/div><div><label>Nouveau code<\/label><input type=\"password\" id=\"nc\" autocomplete=\"new-password\"><\/div><div><label>Confirmer le code<\/label><input type=\"password\" id=\"nc2\" autocomplete=\"new-password\"><\/div><\/div>\n  <button class=\"btn\" onclick=\"chCode()\">Modifier le code<\/button><p class=\"msg\" id=\"cm\"><\/p><\/div>\n<\/section>\n<\/main>\n<div id=\"gate\" class=\"modal\" style=\"z-index:20;background:linear-gradient(160deg,var(--b1),var(--b2),var(--b3))\"><div class=\"box\"><h1 style=\"font-size:28px;background:linear-gradient(90deg,#1e3a8a,#6d28d9);-webkit-background-clip:text;background-clip:text;color:transparent\">MIR-CAISSE<\/h1><div class=\"sub\" style=\"color:var(--violet)\">(Mon application de gestion)<\/div><p style=\"color:var(--muted);font-size:13px\">Entrez le code d'accès à l'application.<\/p><input type=\"password\" id=\"gc\" placeholder=\"Code d'accès\" onkeydown=\"if(event.key==='Enter')gateGo()\"><p id=\"ge\" class=\"msg hide\" style=\"margin:0 0 10px\">Code incorrect.<\/p><button class=\"btn gold\" style=\"width:100%\" onclick=\"gateGo()\">Entrer<\/button><\/div><\/div>\n<div id=\"adm\" class=\"modal hide\"><div class=\"box\"><h2>Accès administrateur<\/h2><p style=\"color:var(--muted);font-size:13px;margin:0\">Entrez le code pour ouvrir les paramètres.<\/p><input type=\"password\" id=\"code\" placeholder=\"Code admin\" onkeydown=\"if(event.key==='Enter')chk()\"><p id=\"err\" class=\"msg hide\" style=\"margin:0 0 10px\">Code incorrect.<\/p><div class=\"bar\"><button class=\"btn ghost\" onclick=\"closeA()\">Annuler<\/button><button class=\"btn\" onclick=\"chk()\">Valider<\/button><\/div><\/div><\/div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js\"><\/script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js\"><\/script>\n<script>\nconst MOIS=['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'],JOURS=['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];\nconst TYPES=['Culte matinal','Culte du soir','Culte de dimanche','Séminaire'],OK={'Culte matinal':[1,2,3,4,5],'Culte du soir':[2,4],'Culte de dimanche':[0],'Séminaire':[0,1,2,3,4,5,6]};\nconst $=id=>document.getElementById(id),opt=(a,f)=>a.map(f).join('');\nconst ls={get(k,d){try{return localStorage.getItem(k)??d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};\nlet data=[];try{data=JSON.parse(ls.get('mir_caisse_data','[]'))}catch(e){}\nconst save=()=>ls.set('mir_caisse_data',JSON.stringify(data)),getCode=()=>ls.get('mir_caisse_code','0987654321'),getApp=()=>ls.get('mir_caisse_app','mircaisse');\nconst fmt=v=>v.toLocaleString('fr-FR',{maximumFractionDigits:2}),calc=(o,d)=>{const t=o+d;return{off:o,dim:d,tot:t,cpt:t*.25,ber:t*.4,fon:t*.35}};\nconst K=['off','dim','tot','cpt','ber','fon'],pad=n=>String(n).padStart(2,'0'),fd=e=>pad(e.d)+'/'+pad(e.m+1)+'/'+e.y;\nlet unlocked=false,pending=null,rows=[];\nconst RB={cpt:'Compte',ber:'Gestion du Berger',fon:'Fonctionnement'},RK=['cpt','ber','fon'];\nlet dep=[];try{dep=JSON.parse(ls.get('mir_caisse_dep','[]'))}catch(e){}\nconst saveD=()=>ls.set('mir_caisse_dep',JSON.stringify(dep));\nconst esc=x=>String(x==null?'':x).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst sumE=(k,f)=>data.filter(f).reduce((s,e)=>s+calc(e.off,e.dim)[k],0),sumD=(k,f)=>dep.filter(x=>x.rub===k&&f(x)).reduce((s,x)=>s+x.mt,0),solde=k=>sumE(k,()=>true)-sumD(k,()=>true);\nconst dkey=e=>new Date(e.y,e.m,e.d).getTime();\nfunction sit(){const y=+$('ry').value,p=$('rp').value,sc=e=>p==='a'||e.y===y,bf=e=>p!=='a'&&e.y<y;return RK.map(k=>{const r=sumE(k,bf)-sumD(k,bf),en=sumE(k,sc),d=sumD(k,sc);return{l:RB[k],r,en,d,rs:r+en-d}})}\nfunction dDate(){const n=new Date();$('dd').value=pad(n.getDate())+'/'+pad(n.getMonth()+1)+'/'+n.getFullYear()}\nfunction dSolde(){const k=$('dr').value;$('dso').value=k?fmt(solde(k))+' FCFA':''}\nlet actx=null,chkT=null;\nfunction beep(ok){try{actx=actx||new (window.AudioContext||window.webkitAudioContext)();if(actx.state==='suspended')actx.resume();const seq=ok?[[660,0],[880,.14]]:[[880,0],[440,.2],[880,.4],[440,.6]];\n seq.forEach(([fq,t])=>{const o=actx.createOscillator(),g=actx.createGain(),b=actx.currentTime+t;o.type=ok?'sine':'square';o.frequency.value=fq;g.gain.setValueAtTime(.0001,b);g.gain.exponentialRampToValueAtTime(ok?.25:.3,b+.02);g.gain.exponentialRampToValueAtTime(.0001,b+(ok?.13:.18));o.connect(g);g.connect(actx.destination);o.start(b);o.stop(b+.2)});if(!ok&&navigator.vibrate)try{navigator.vibrate([200,100,200])}catch(e){}}catch(e){}}\nfunction chkD(){clearTimeout(chkT);const el=$('dso');el.classList.remove('dso-ok','dso-no','blink');\n const k=$('dr').value,mt=Math.max(0,+$('dm2').value||0);if(!k||!mt)return;\n chkT=setTimeout(()=>{const ok=mt<=solde(k);void el.offsetWidth;el.classList.add(ok?'dso-ok':'dso-no','blink');beep(ok)},450)}\nfunction addD(){const M=$('dmsg'),k=$('dr').value,mt=Math.max(0,+$('dm2').value||0),mo=$('dmo').value.trim();M.className='msg';\n if(!k){M.textContent='Choisissez la rubrique sur laquelle la dépense est faite.';return}\n if(!mt){M.textContent='Saisissez un montant supérieur à 0.';return}\n if(!mo){M.textContent='Saisissez le motif de la dépense.';return}\n const so=solde(k);if(mt>so&&!confirm(`Le montant (${fmt(mt)}) dépasse le solde disponible de « ${RB[k]} » (${fmt(so)}). Enregistrer quand même ?`))return;\n const n=new Date();dep.push({id:Date.now(),y:n.getFullYear(),m:n.getMonth(),d:n.getDate(),rub:k,mt,mo});saveD();\n $('dm2').value=0;$('dmo').value='';dSolde();chkD();dDate();recD();M.className='msg ok';M.textContent=`Dépense enregistrée. Il reste ${fmt(solde(k))} FCFA sur « ${RB[k]} ».`}\nfunction recD(){const r=[...dep].sort((a,b)=>b.id-a.id).slice(0,8);$('recd').innerHTML=r.length?opt(r,x=>`<tr><td>${fd(x)}<\/td><td>${RB[x.rub]}<\/td><td class=\"w\">${esc(x.mo)}<\/td><td class=\"n\"><b>${fmt(x.mt)}<\/b><\/td><\/tr>`):'<tr><td colspan=\"4\" class=\"empty\">Aucune dépense.<\/td><\/tr>'}\nfunction repX(){const y=+$('ry').value,p=$('rp').value,sc=e=>p==='a'||e.y===y,lab=p==='a'?'toutes les années':y;\n $('sh').textContent='Situation des rubriques — '+lab;$('oh').textContent='Sorties de caisse (dépenses) — '+lab;\n const S=sit(),T=S.reduce((a,r)=>({r:a.r+r.r,en:a.en+r.en,d:a.d+r.d,rs:a.rs+r.rs}),{r:0,en:0,d:0,rs:0}),rc=v=>`<td class=\"n ${v<0?'neg':''}\"><b>${fmt(v)}<\/b><\/td>`;\n $('sb').innerHTML=opt(S,r=>`<tr><td><b>${r.l}<\/b><\/td><td class=\"n\">${fmt(r.r)}<\/td><td class=\"n\">${fmt(r.en)}<\/td><td class=\"n\">${fmt(r.d)}<\/td>${rc(r.rs)}<\/tr>`);\n $('sf').innerHTML=`<tr><td>TOTAL<\/td><td class=\"n\">${fmt(T.r)}<\/td><td class=\"n\">${fmt(T.en)}<\/td><td class=\"n\">${fmt(T.d)}<\/td>${rc(T.rs)}<\/tr>`;\n const L=dep.filter(sc).sort((a,b)=>dkey(a)-dkey(b)||a.id-b.id);\n $('ob').innerHTML=L.length?opt(L,x=>`<tr><td>${fd(x)}<\/td><td>${RB[x.rub]}<\/td><td class=\"w\">${esc(x.mo)}<\/td><td class=\"n\">${fmt(x.mt)}<\/td><\/tr>`):'<tr><td colspan=\"4\" class=\"empty\">Aucune dépense pour cette sélection.<\/td><\/tr>';\n $('of').innerHTML=L.length?`<tr><td colspan=\"3\">TOTAL DES DÉPENSES<\/td><td class=\"n\">${fmt(L.reduce((s,x)=>s+x.mt,0))}<\/td><\/tr>`:''}\nfunction ask(f){pending=f;$('code').value='';$('err').classList.add('hide');$('adm').classList.remove('hide');$('code').focus()}\nfunction gateGo(){if($('gc').value===getApp()){$('gate').classList.add('hide');$('nv').classList.remove('hide');$('mn').classList.remove('hide')}else{$('ge').classList.remove('hide');$('gc').value=''}}\nfunction closeA(){pending=null;$('adm').classList.add('hide')}\nfunction chk(){if($('code').value===getCode()){const f=pending;closeA();if(f)f()}else{$('err').classList.remove('hide');$('code').value=''}}\nfunction tab(t){if(t==='p'&&!unlocked){ask(()=>{unlocked=true;go('p')});return}if(t!=='p'){unlocked=false;$('lk').classList.remove('hide')}go(t)}\nfunction go(t){['s','r','p'].forEach(x=>{$('t'+x).classList.toggle('hide',x!==t);$('b'+x).classList.toggle('on',x===t)});if(t==='s'){dDate();dSolde()}if(t==='r')report();if(t==='p'){$('lk').classList.add('hide');fillDel()}}\nfunction fillDays(){const y=+$('y').value,m=+$('m').value,n=new Date(y,m+1,0).getDate(),c=+$('d').value||1;$('d').innerHTML=opt(Array.from({length:n},(_,i)=>i+1),d=>`<option value=\"${d}\">${d} (${JOURS[new Date(y,m,d).getDay()].slice(0,3)})<\/option>`);$('d').value=Math.min(c,n)}\nfunction recalc(){const c=calc(Math.max(0,+$('off').value||0),Math.max(0,+$('dim').value||0));['tot','cpt','ber','fon'].forEach(k=>$(k).value=fmt(c[k]))}\nfunction add(){const v=$('dt').value,M=$('msg');if(!v){M.className='msg';M.textContent='Choisissez une date dans le calendrier.';return}const [y,m0,d]=v.split('-').map(Number),m=m0-1,ty=$('ty').value,w=new Date(y,m,d).getDay();\n if(!OK[ty].includes(w)){M.className='msg';M.textContent=`« ${ty} » ne se tient pas le ${JOURS[w].toLowerCase()}.`;return}\n if(data.some(e=>e.y===y&&e.m===m&&e.d===d&&e.ty===ty)&&!confirm('Une entrée existe déjà pour ce culte à cette date. Ajouter quand même ?'))return;\n data.push({id:Date.now(),ty,y,m,d,off:Math.max(0,+$('off').value||0),dim:Math.max(0,+$('dim').value||0)});save();\n $('off').value=0;$('dim').value=0;recalc();M.className='msg ok';M.textContent='Entrée enregistrée.';rec()}\nfunction rec(){const r=[...data].sort((a,b)=>b.id-a.id).slice(0,8);$('rec').innerHTML=r.length?opt(r,e=>`<tr><td>${fd(e)}<\/td><td>${e.ty}<\/td><td class=\"n\">${fmt(e.off)}<\/td><td class=\"n\">${fmt(e.dim)}<\/td><td class=\"n\"><b>${fmt(e.off+e.dim)}<\/b><\/td><\/tr>`):'<tr><td colspan=\"5\" class=\"empty\">Aucune entrée.<\/td><\/tr>'}\nfunction agg(y,a,b,t){const r=data.filter(e=>e.y===y&&e.m>=a&&e.m<=b&&(!t||e.ty===t)),s=calc(r.reduce((x,e)=>x+e.off,0),r.reduce((x,e)=>x+e.dim,0));s.n=r.length;return s}\nfunction report(){const y=+$('ry').value,p=$('rp').value,t=$('rt').value;$('ryw').classList.toggle('hide',p==='a');let L=[];\n if(p==='m')L=MOIS.map((l,i)=>({l,c:agg(y,i,i,t),p:i?agg(y,i-1,i-1,t):agg(y-1,11,11,t)}));\n else if(p==='t')L=[0,1,2,3].m